# Stayshay's WhatsApp business number (E.164, digits only). Used for the general "Talk to us" button
# and as the inquiry fallback until listers have their own verified numbers.
# Optional override; defaults to BRAND.whatsapp (+971 56 904 8493)
NEXT_PUBLIC_STAYSHAY_WHATSAPP=

# Optional: every submitted inquiry is POSTed here as JSON (n8n / Zapier / Supabase function).
STAYSHAY_INQUIRY_WEBHOOK=

# Password for /admin (where the team creates listings from WhatsApp submissions)
ADMIN_PASSWORD=
# Where admin listings + uploaded photos are stored (default apps/web/.data)
STAYSHAY_DATA_DIR=

# Signs login cookies. 32+ random characters (openssl rand -base64 36)
SESSION_SECRET=
# Comma-separated emails that get admin access when signed in (Google or email)
ADMIN_EMAILS=
# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
# Authorized redirect URI: https://stayshay.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shay, the AI assistant (console.anthropic.com > API keys). Without it the chat shows a WhatsApp fallback.
ANTHROPIC_API_KEY=
